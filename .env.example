# ─────────────────────────────────────────────────────────────
# Estudio Ayuch — variables de entorno
#   cp .env.example .env   y completar TODOS los valores marcados con CHANGEME
# ─────────────────────────────────────────────────────────────

# Base de datos (gestión)
DB_HOST=db
DB_PORT=3306
DB_NAME=db_estudio_ayuch
DB_USER=dev_user
DB_PASSWORD=dev_pass

# Base de datos (autenticación)
AUTH_DB_HOST=db
AUTH_DB_PORT=3306
AUTH_DB_NAME=db_estudio_ayuch_auth
AUTH_DB_USER=dev_user
AUTH_DB_PASSWORD=dev_pass

# Password root de MySQL (OBLIGATORIO — el compose no arranca sin esto).
# Generar con:  openssl rand -hex 24
MYSQL_ROOT_PASSWORD=CHANGEME

# Seguridad JWT (OBLIGATORIO cambiar — nunca usar el valor de ejemplo).
# Generar con:  openssl rand -hex 32
JWT_SECRET=CHANGEME

# Orígenes CORS permitidos, separados por coma (sin espacios finales).
# En producción (frontend same-origin vía nginx /api) se puede dejar vacío
# o con el dominio real, ej: CORS_ORIGINS=https://ayuch.midominio.com
# Si se deja vacío, solo se permite el dev-server de Vite (localhost:5173).
CORS_ORIGINS=

# URL pública del backend, embebida en el bundle del frontend en build.
# Recomendado (same-origin vía nginx): VITE_API_URL=/api
# Alternativa con Apache proxyeando: https://tu-dominio/api
VITE_API_URL=/api

# ⚠️ Recordatorio post-deploy:
#   El seed crea el usuario admin con password "admin123".
#   Cambiarla INMEDIATAMENTE después del primer login (o desde la sección Usuarios).
